{
  "name": "vaultage-open-local",
  "version": "1.0.0",
  "description": "Encrypted key/secret vault with Touch ID",
  "productName": "Vaultage",
  "main": "out/main/index.js",
  "scripts": {
    "build:helper": "bash build-helper.sh",
    "predev": "bash build-helper.sh",
    "dev": "electron-vite dev",
    "build": "pnpm build:open-local",
    "build:open-local": "node scripts/build-open-local.mjs",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:entitlements": "node scripts/check-entitlements.mjs",
    "check:open-artifact": "node scripts/check-open-artifact.mjs",
    "check:source-drop-secrets": "node scripts/check-source-drop-secrets.mjs",
    "check:schemas": "node scripts/check-schemas.mjs",
    "publish:check": "node scripts/publish-readiness.mjs",
    "smoke:mac-entitlements": "node scripts/smoke-mac-entitlements.mjs",
    "verify:release": "node scripts/release-gates.open.mjs",
    "start": "electron-vite dev",
    "dist:mac": "bash build-helper.sh && VAULTAGE_OPEN_CORE=1 electron-vite build && electron-builder --mac --universal",
    "dist:win": "VAULTAGE_OPEN_CORE=1 electron-vite build && electron-builder --win --x64",
    "dist:all": "pnpm dist:mac && pnpm dist:win"
  },
  "pnpm": {
    "overrides": {
      "tmp": "0.2.6"
    },
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^39.8.10",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.16.0",
    "simple-icons": "^16.21.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0"
  },
  "license": "Apache-2.0"
}
