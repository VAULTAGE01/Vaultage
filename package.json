{
  "name": "vaultage-open-local",
  "version": "0.1.0",
  "packageManager": "pnpm@11.11.0",
  "description": "Encrypted key/secret vault with Touch ID",
  "productName": "vault-OC",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:helper": "bash build-helper.sh",
    "predev": "bash build-helper.sh",
    "dev": "VAULTAGE_OPEN_CORE=1 electron-vite dev",
    "build": "pnpm build:open-local",
    "build:open-local": "node scripts/build-open-local.mjs",
    "package:open-local": "node scripts/package-open-local.mjs",
    "test": "vitest run",
    "test:portable": "vitest run --exclude src/main/browserExtensionNativeHostRegistrar.test.ts",
    "check:open-types": "node scripts/check-open-types.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:entitlements": "node scripts/check-entitlements.mjs",
    "check:electron-fuses": "node scripts/check-electron-fuses.mjs",
    "check:keychain-boundary": "node scripts/check-keychain-boundary.mjs",
    "check:open-artifact": "node scripts/check-open-artifact.mjs",
    "check:preload-surfaces": "node scripts/check-preload-surfaces.mjs",
    "check:bundle-budgets": "node scripts/check-bundle-budgets.mjs",
    "check:release-metadata": "node scripts/check-release-metadata.mjs",
    "check:script-targets": "node scripts/check-script-targets.mjs",
    "check:source-drop-secrets": "node scripts/check-source-drop-secrets.mjs",
    "check:schemas": "node scripts/check-schemas.mjs",
    "check:product-truth": "node scripts/check-product-truth.mjs",
    "publish:check": "node scripts/publish-readiness.mjs",
    "smoke:mac-entitlements": "node scripts/smoke-mac-entitlements.mjs",
    "smoke:packaged-app": "node scripts/smoke-packaged-app.mjs",
    "sbom:generate": "pnpm sbom --sbom-format cyclonedx --sbom-spec-version 1.7 --sbom-type application --prod --out dist/vaultage-dependencies.cdx.json",
    "verify:release": "node scripts/release-gates.open.mjs",
    "start": "VAULTAGE_OPEN_CORE=1 electron-vite dev",
    "dist:mac": "pnpm build:open-local && electron-builder --mac --universal",
    "prestart": "bash build-helper.sh"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.5.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.6",
    "electron-builder-squirrel-windows": "^26.15.6",
    "electron-vite": "^5.0.0",
    "js-yaml": "4.3.0",
    "postcss": "^8.5.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.16.0",
    "simple-icons": "^16.21.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "license": "Apache-2.0"
}
